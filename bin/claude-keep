#!/usr/bin/env bash
# claude-keep — claude-session-keeper: persist long-running Claude Code (Remote Control)
# tmux sessions across reboots and crashes, and self-heal them on a timer.
#
# A session registers ITSELF (no args — reads its own env), the registry is a
# plain TSV, and `claude-keep restore` re-launches anything that died. A systemd --user
# timer runs `restore` periodically so a session that dies (reboot, OOM, the Mac
# sleeping and dropping a network-mounted cwd) comes back on its own.
#
# Subcommands:
#   claude-keep add [--no-rc] [--effort <e>]   Register THIS session (reads $CLAUDE_CODE_SESSION_ID,
#                                      the tmux session name, $PWD, $CLAUDE_EFFORT).
#   claude-keep rm [name]                      Remove THIS session (no arg) or a named one.
#   claude-keep ls                             List the registry + who is live right now.
#   claude-keep doctor                         Audit registry vs transcripts: flag DRIFT (transcript moved
#                                      to another cwd, e.g. a git worktree), DEAD-CWD, or LOST entries —
#                                      the ones that silently fail to resume. Read-only; suggests fixes.
#   claude-keep migrate <session> <new-cwd>    Relocate a session's transcript to a new cwd (copy jsonl +
#                                      repoint registry) so it resumes there — fixes a DRIFT/DEAD-CWD, or
#                                      deliberately moves a session's working dir. Original kept as backup.
#   claude-keep restore                        Re-launch every registered session that isn't live, then
#                                      tidy the live ones. (Auto-heals a drifted transcript; skips a lost one.)
#   claude-keep tidy                           Tidy LIVE sessions only (no relaunch): clear a stuck "Resume
#                                      session?" dialog (option 2 = full) or a stuck Remote Control panel,
#                                      RE-ESTABLISH Remote Control when its bridge is genuinely absent (read
#                                      from ~/.claude/sessions/<pid>.json, not the flaky /rc footer), and
#                                      alert (via $KEEP_NOTIFY_CMD) if the shared login is logged out.
#   claude-keep status                         Print the state engine's per-session records as JSON
#                                      (registry + tmux + ~/.claude/sessions state + parsed TUI, merged).
#   claude-keep install-timer [--interval M]   Install a systemd --user timer (default 5 min) → restore (+tidy).
#   claude-keep uninstall-timer                Remove the restore timer.
#
# Registry: ${CLAUDE_KEEP_HOME:-~/.claude-keep}/sessions.tsv
#   columns: tmux_name <TAB> uuid <TAB> cwd <TAB> effort <TAB> rc
#   rc=1 → re-issue /remote-control after resume (these are Remote Control sessions);
#   rc=0 → plain tmux session, no Remote Control.
#
# Notes:
#   - model is NOT stored: `claude --resume <uuid>` restores the session's own model.
#   - restore answers the "Resume session?" dialog with option 2 (full) — never a
#     lossy summary — matching the long-running-session convention.
#   - a missing/unreachable cwd (e.g. a network mount not up yet) is SKIPPED, not
#     failed — the next timer tick retries once the mount is back. claude-keep knows nothing
#     about mounts; keep mounts healthy with their own keeper.
#   - restore paces its relaunches and STOPS if free memory drops below a floor
#     ($KEEP_RESTORE_MEM_MIN MiB, default 400), leaving the rest for the next tick — so an
#     OOM-driven mass restart can't pile N heavy `--resume` processes onto an already-tight box.

set -uo pipefail

CLAUDE_KEEP_HOME="${CLAUDE_KEEP_HOME:-$HOME/.claude-keep}"
TSV="$CLAUDE_KEEP_HOME/sessions.tsv"
# Resolve the claude binary to an absolute path: prefer PATH, then known install
# locations. The systemd --user timer runs with a minimal PATH that usually lacks
# ~/.npm-global/bin, so a bare `command -v claude` is not enough. Honour an explicit
# $CLAUDE override. (Mirrors resolve_claude() in claude-remote-launcher.)
_resolve_claude() {
  local c
  c=$(command -v claude 2>/dev/null) && { printf '%s\n' "$c"; return 0; }
  for c in "$HOME/.npm-global/bin/claude" "$HOME/.local/bin/claude" \
           "$HOME/.claude/local/claude" /usr/local/bin/claude; do
    [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
  done
  printf '%s\n' "$HOME/.npm-global/bin/claude"   # last-resort guess; -x is checked at use
}
CLAUDE="${CLAUDE:-$(_resolve_claude)}"
EM=$'—'   # em-dash used in cc— session names

# ── restore memory gate ───────────────────────────────────────────────────────
# Under sustained memory pressure, relaunching dead sessions can DEEPEN the problem:
# each `claude --resume` is a full process loading its whole transcript → a real memory
# spike. restore already serialises launches (it blocks in _drive_restore driving each
# session's resume dialog before moving on), so it never forks a whole batch at once —
# but the cumulative footprint of N resumed processes can still exhaust a tight box. So
# before EACH launch restore checks free memory and, if it's below the floor, STOPS and
# leaves the rest for the next tick (best-effort — it converges as memory frees), alerting
# that some sessions are still down. Both knobs overridable; a box with `free` missing is
# treated as "plenty" (the gate never blocks on a missing reading).
KEEP_RESTORE_MEM_MIN="${KEEP_RESTORE_MEM_MIN:-400}"   # MiB-available floor; stop launching below it
KEEP_RESTORE_PAUSE="${KEEP_RESTORE_PAUSE:-2}"         # settle margin (s) after a launch before the next
_avail_mib() { free -m 2>/dev/null | awk '/^Mem:/{print $7}'; }

# ── styled output ─────────────────────────────────────────
if [[ -t 1 ]]; then
  _g() { printf '\033[32m%s\033[0m' "$*"; }
  _y() { printf '\033[33m%s\033[0m' "$*"; }
  _r() { printf '\033[31m%s\033[0m' "$*"; }
  _b() { printf '\033[1m%s\033[0m' "$*"; }
else
  _g() { printf '%s' "$*"; }; _y() { printf '%s' "$*"; }
  _r() { printf '%s' "$*"; }; _b() { printf '%s' "$*"; }
fi
die() { _r "✗ $*" >&2; echo >&2; exit 1; }

# ── notifications (optional, pluggable) ───────────────────────────────────────
# The keeper never sends over the network itself and bundles no notifier. Point
# $KEEP_NOTIFY_CMD at ANY command that takes the message as its first argument — a
# Telegram bot wrapper, an ntfy one-liner (`curl -d "$1" ntfy.sh/your-topic`), your
# own script — to receive alerts. Unset → the keeper stays silent (logs to stderr).
# This keeps the repo notifier-agnostic; wire your channel in via the env var.
notify() {
  local cmd="${KEEP_NOTIFY_CMD:-}"
  if [[ -n "$cmd" ]]; then
    "$cmd" "$*" >/dev/null 2>&1 || printf 'claude-keep: notify failed: %s\n' "$*" >&2
  else
    printf 'claude-keep: [no notifier] %s\n' "$*" >&2
  fi
}

ensure_registry() {
  mkdir -p "$CLAUDE_KEEP_HOME"
  if [[ ! -f "$TSV" ]]; then
    {
      echo "# claude-session-keeper registry"
      echo "# tmux_name<TAB>uuid<TAB>cwd<TAB>effort<TAB>rc   (rc=1 → re-enable Remote Control)"
    } > "$TSV"
  fi
}

# ── identify the calling session from its own environment ──
self_tmux_name() { tmux display-message -p '#{session_name}' 2>/dev/null; }
self_uuid()      { printf '%s' "${CLAUDE_CODE_SESSION_ID:-}"; }
self_effort()    { printf '%s' "${CLAUDE_EFFORT:-}"; }

# exact field-1 (tmux_name) match — NOT a substring grep, which would let
# "neighbor/x" match inside "cc—neighbor/x".
_has_row() {
  awk -F'\t' -v n="$1" '$1==n {found=1} END{exit found?0:1}' "$TSV" 2>/dev/null
}
# remove any registry row whose tmux_name (field 1) equals $1; returns 0 iff it removed one
_drop_row() {
  _has_row "$1" || return 1
  local tmp; tmp=$(mktemp)
  awk -F'\t' -v n="$1" 'NF==0 || $1 ~ /^#/ || $1 != n' "$TSV" > "$tmp" && mv "$tmp" "$TSV"
}

# ──────────────────────────────────────────────────────────────────
cmd_add() {
  local no_rc=0 effort_override="" rc=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-rc) no_rc=1 ;;
      --effort) effort_override="${2:-}"; shift ;;
      *) die "add: unknown arg '$1'" ;;
    esac
    shift
  done

  local uuid name cwd effort
  uuid=$(self_uuid)
  name=$(self_tmux_name)
  cwd="$PWD"
  effort="${effort_override:-$(self_effort)}"
  (( no_rc )) && rc=0

  [[ -n "$uuid" ]] || die "no \$CLAUDE_CODE_SESSION_ID — run 'claude-keep add' from inside a Claude Code session"
  [[ -n "$name" ]] || die "not inside a tmux session (no \$TMUX) — claude-keep tracks tmux sessions"

  ensure_registry
  _drop_row "$name"                                   # upsert by tmux_name
  printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$uuid" "$cwd" "$effort" "$rc" >> "$TSV"
  _g "✓ registered: $name"; echo
  echo "    uuid:   $uuid"
  echo "    cwd:    $cwd"
  echo "    effort: ${effort:-<default>}    remote-control: $([[ $rc == 1 ]] && echo yes || echo no)"
}

# ──────────────────────────────────────────────────────────────────
cmd_rm() {
  ensure_registry
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    name=$(self_tmux_name)
    [[ -n "$name" ]] || die "rm: no session name given and not inside a tmux session"
  elif ! _has_row "$name" && _has_row "cc${EM}${name}"; then
    name="cc${EM}${name}"          # accept the bare title (without the cc— prefix)
  fi
  if _drop_row "$name"; then
    _g "✓ removed: $name"; echo
  else
    _y "not in registry: $name"; echo
  fi
}

# Split a TSV registry line into ROW_NAME/UUID/CWD/EFFORT/RC, PRESERVING empty
# fields. `IFS=$'\t' read` collapses consecutive tabs (tab is a whitespace IFS),
# which drops an empty effort field and shifts rc into it — so don't use it.
_split_row() {
  local rest="$1"
  ROW_NAME="${rest%%$'\t'*}";   rest="${rest#*$'\t'}"
  ROW_UUID="${rest%%$'\t'*}";   rest="${rest#*$'\t'}"
  ROW_CWD="${rest%%$'\t'*}";    rest="${rest#*$'\t'}"
  ROW_EFFORT="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
  ROW_RC="$rest"
}

# ──────────────────────────────────────────────────────────────────
cmd_ls() {
  ensure_registry
  printf "  %-46s  %-5s  %-8s  %-7s  %s\n" "tmux session" "live" "effort" "rc" "cwd"
  printf "  %-46s  %-5s  %-8s  %-7s  %s\n" "$(printf '%.0s-' {1..46})" "-----" "--------" "-------" "----"
  local n_total=0 n_live=0
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ -z "$_line" || "${_line:0:1}" == "#" ]] && continue
    _split_row "$_line"
    local name="$ROW_NAME" uuid="$ROW_UUID" cwd="$ROW_CWD" effort="$ROW_EFFORT" rc="$ROW_RC"
    n_total=$((n_total+1))
    local live="✗"
    if tmux has-session -t "=$name" 2>/dev/null; then live="✓"; n_live=$((n_live+1)); fi
    local cwd_mark="$cwd"
    [[ -d "$cwd" ]] || cwd_mark="$cwd  (missing)"
    printf "  %-46s  %-5s  %-8s  %-7s  %s\n" "$name" "$live" "${effort:-—}" "$([[ "${rc:-1}" == 1 ]] && echo yes || echo no)" "$cwd_mark"
  done < "$TSV"
  echo
  echo "  $n_live/$n_total live   (registry: $TSV)"
}

# ── drive a freshly-resumed pane: answer the resume dialog, re-enable RC ──
# _drive_restore — after a fresh launch, bring the session to RC-active. Dialog
# handling (resume prompt, RC panel, Enable-RC confirm) is delegated to the shared
# _tidy_pane; the one thing only THIS needs is issuing /remote-control on a fresh
# session. Addresses the pane by %id (capture-pane -t "=<em-dash name>" returns empty).
_drive_restore() {
  local name="$1" rc="$2" title="${name#cc${EM}}"
  local pid; pid=$(_pane_of "$name"); [[ -z "$pid" ]] && return 0
  # Big/old sessions take a while to load before the resume dialog appears — keep the
  # window wide (KEEP_DRIVE_TIMEOUT, default 180s) so it gets driven, not left stuck.
  local deadline=$((SECONDS + ${KEEP_DRIVE_TIMEOUT:-180})) pane did_rc=0
  while (( SECONDS < deadline )); do
    _tidy_pane "$pid"                     # answer resume dialog (full), dismiss panels, confirm Enable-RC
    pane=$(tmux capture-pane -p -J -t "$pid" -S -200 2>/dev/null || true)
    grep -q 'esc to interrupt' <<<"$pane" && { sleep 1; continue; }   # still loading — wait
    if [[ "$rc" == "1" ]]; then
      grep -qiE 'remote-control is active|Remote Control active|/rc active|available in the Claude mobile app' <<<"$pane" && return 0
      # TUI ready, RC not yet enabled → enable it (the one action tidy deliberately won't do)
      if (( !did_rc )) && grep -q 'bypass permissions on' <<<"$pane"; then
        tmux send-keys -t "$pid" "/remote-control ${title}"; sleep 0.4; tmux send-keys -t "$pid" Enter; did_rc=1
      fi
    else
      grep -q 'bypass permissions on' <<<"$pane" && return 0
    fi
    sleep 1
  done
  return 0   # best-effort; never block the restore loop
}

# ──────────────────────────────────────────────────────────────────
cmd_restore() {
  ensure_registry
  [[ -x "$CLAUDE" ]] || die "claude not executable at $CLAUDE (set \$CLAUDE)"
  command -v tmux >/dev/null || die "tmux not installed"

  if ! "$CLAUDE" auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    _y "⚠ claude not logged in — sessions will start but API calls 401 until: $CLAUDE auth login"; echo
  fi

  local launched=0 skipped=0 waiting=0
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ -z "$_line" || "${_line:0:1}" == "#" ]] && continue
    _split_row "$_line"
    local name="$ROW_NAME" uuid="$ROW_UUID" cwd="$ROW_CWD" effort="$ROW_EFFORT" rc="$ROW_RC"
    rc="${rc:-1}"

    if tmux has-session -t "=$name" 2>/dev/null; then
      skipped=$((skipped+1)); continue
    fi
    # cwd not ready (e.g. a network mount still down) → leave for the next tick
    if [[ ! -d "$cwd" ]] || ! timeout 8 ls "$cwd" >/dev/null 2>&1; then
      _y "  … waiting on cwd: $name ($cwd)"; echo
      waiting=$((waiting+1)); continue
    fi

    # The transcript must sit in THIS cwd's project dir or `--resume` dies instantly
    # (the session then looks like it "won't come up"). Auto-heal a DRIFTED transcript
    # (session wandered into a git worktree, cwd later deleted, …) by copying it into
    # place; skip a truly LOST one instead of launching a doomed resume. (See `doctor`.)
    local _expect; _expect="$(_projdir_for "$cwd")/$uuid.jsonl"
    if [[ ! -f "$_expect" ]]; then
      local _drift; _drift="$(_find_transcript "$uuid")"
      if [[ -n "$_drift" ]]; then
        mkdir -p "$(dirname "$_expect")"; cp "$_drift" "$_expect"
        _y "  ↪ healed drift: $name (transcript ← ${_drift%/*})"; echo
      else
        _r "  ✗ no transcript for $name (${uuid:0:8}…) — skipping (run: claude-keep doctor)"; echo
        continue
      fi
    fi

    # memory gate: don't pile new claude processes onto an already-tight box — relaunch
    # what we can now, leave the rest for the next tick (converges as memory frees).
    local _mib; _mib=$(_avail_mib)
    if [[ -n "$_mib" ]] && (( _mib < KEEP_RESTORE_MEM_MIN )); then
      _y "  ⏸ low memory (${_mib}MiB < ${KEEP_RESTORE_MEM_MIN}MiB) — deferring remaining relaunches to next tick"; echo
      notify "⚠ claude-keep: relaunches paused — only ${_mib}MiB free (< ${KEEP_RESTORE_MEM_MIN}); some sessions still down, retrying next tick"
      break
    fi

    local launch="$CLAUDE --dangerously-skip-permissions --resume $uuid"
    [[ -n "${effort:-}" ]] && launch+=" --effort $effort"
    if tmux new-session -d -s "$name" -c "$cwd" "$launch" 2>/dev/null; then
      _drive_restore "$name" "$rc"
      _g "  ✨ restored: $name"; echo
      launched=$((launched+1))
      sleep "$KEEP_RESTORE_PAUSE"   # let the resumed process's footprint register before the next gate check
    else
      _r "  ✗ tmux launch failed: $name"; echo
      notify "⚠ claude-keep: session '$name' is down and tmux relaunch failed — needs a human"
    fi
  done < "$TSV"

  # Second pass: tidy every LIVE session (clear stuck resume dialogs / RC panels left
  # by a launch whose drive window closed, and by manual /remote-control re-issues) and
  # emit the /login alert. One timer thus keeps sessions both ALIVE and USABLE.
  _do_tidy_sweep

  echo
  echo "restore: launched=$launched, already-live=$skipped, waiting-on-cwd=$waiting (+ tidied live)"
}

# ──────────────────────────────────────────────────────────────────
cmd_install_timer() {
  local interval=5
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="${2:-5}"; shift ;;
      *) die "install-timer: unknown arg '$1'" ;;
    esac
    shift
  done
  local self; self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude-keep
  local ud="$HOME/.config/systemd/user"
  mkdir -p "$ud"

  cat > "$ud/claude-keep-restore.service" <<EOF
[Unit]
Description=claude-session-keeper — restore missing sessions
[Service]
Type=oneshot
Environment=CLAUDE_KEEP_HOME=$CLAUDE_KEEP_HOME
ExecStart=$self restore
EOF

  cat > "$ud/claude-keep-restore.timer" <<EOF
[Unit]
Description=claude-session-keeper — periodic self-heal
[Timer]
OnBootSec=2min
OnUnitActiveSec=${interval}min
Persistent=true
[Install]
WantedBy=timers.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now claude-keep-restore.timer >/dev/null 2>&1
  # survive logout / run after reboot without an active login session
  loginctl enable-linger "$USER" >/dev/null 2>&1 || \
    _y "⚠ could not enable-linger; timer may not run before you log in after a reboot"

  _g "✓ timer installed: every ${interval} min (+2 min after boot)"; echo
  echo "    check:  systemctl --user list-timers claude-keep-restore.timer"
  echo "    logs:   journalctl --user -u claude-keep-restore.service"
}

cmd_uninstall_timer() {
  local ud="$HOME/.config/systemd/user"
  systemctl --user disable --now claude-keep-restore.timer >/dev/null 2>&1
  rm -f "$ud/claude-keep-restore.timer" "$ud/claude-keep-restore.service"
  systemctl --user daemon-reload
  _g "✓ timer removed"; echo
}

# Tier-1 machine-wide login state from the SHARED OAuth credential file.
# All sessions share ~/.claude/.credentials.json, so this is read once, not per-session.
# Returns: ok | login-needed
#
# IMPORTANT: `expiresAt` in the past is NORMAL, not "login needed". That field is the
# ACCESS token's expiry; as long as a refreshToken is present it refreshes transparently
# on next use (observed: a design token 97h "expired" yet still working). So the only
# hard, file-visible "run /login" signal is a MISSING oauth block or MISSING refreshToken
# (genuinely logged out / revoked). A refresh that fails despite a present refreshToken
# isn't visible here — that surfaces as a /login prompt in the pane (a future Tier-3 add).
_login_state() {
  local f="$HOME/.claude/.credentials.json"
  [[ -r "$f" ]] || { echo ok; return; }   # can't read → don't false-alarm
  python3 - "$f" <<'PY' 2>/dev/null || echo ok
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print("ok"); sys.exit()
o=d.get("claudeAiOauth")
if not o or not o.get("refreshToken"):   # no way to refresh → real re-login needed
    print("login-needed"); sys.exit()
print("ok")                              # refreshToken present → expired access auto-refreshes
PY
}

# Resolve a session name to its pane id via EXACT-match. capture-pane's `-t =name`
# exact form silently returns empty for these em-dash/slash session names, and the
# `=`-less form prefix-matches (jeevy vs jeevy-2/-3 collide) → wrong pane. Matching
# the full name in awk and capturing by pane id (%N) is exact and collision-proof.
_pane_of() { tmux list-panes -a -F $'#{session_name}\t#{pane_id}' 2>/dev/null | awk -F'\t' -v s="$1" '$1==s{print $2; exit}'; }

_projdir_for()    { printf '%s/%s' "$HOME/.claude/projects" "$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"; }
_find_transcript(){ ls -1 "$HOME/.claude/projects"/*/"$1.jsonl" 2>/dev/null | head -1; }

# ── dialog tidying — the shared "usable state" primitive ──────────────────────
# _tidy_pane <pane-id>: bring a session's TUI to a clean prompt. Answers a stuck
# "Resume session?" dialog (option 2 = full, never a lossy summary), dismisses a stuck
# Remote Control management panel (Disconnect / QR / Continue), and confirms the one-time
# "Enable Remote Control" prompt. IDLE-GATED (never touches a mid-generation session) and
# SAFE — it only answers/dismisses dialogs, it NEVER re-issues /remote-control (that class
# of action is what left panels stuck in the first place). A short bounded loop so a
# two-step dialog (Down then Enter) fully clears in one call.
_tidy_pane() {
  local pid="$1" pane i
  for i in 1 2 3 4 5 6 7 8; do
    pane=$(tmux capture-pane -p -J -t "$pid" -S -80 2>/dev/null || true)
    grep -q 'esc to interrupt' <<<"$pane" && return 0                # busy → leave it alone
    if grep -q 'Resume full session as-is' <<<"$pane"; then          # resume dialog → option 2 (full)
      if grep -qE '❯.*Resume full session as-is' <<<"$pane"; then tmux send-keys -t "$pid" Enter; sleep 1
      else tmux send-keys -t "$pid" Down; sleep 0.5; fi
      continue
    fi
    if grep -qiE 'Disconnect this session|Enter to select · Esc to continue' <<<"$pane"; then
      tmux send-keys -t "$pid" Enter; sleep 0.6; continue            # stuck RC panel → dismiss
    fi
    if grep -q 'Enable Remote Control' <<<"$pane"; then
      tmux send-keys -t "$pid" Enter; sleep 0.6; continue            # one-time Enable-RC → confirm
    fi
    return 0                                                         # no dialog → clean
  done
  return 0
}

# The per-session RC/idle facts that used to be scraped here (`_state_for`) now come from the
# tested Python engine — see lib/state_engine.py (parse_state → bridge presence + status) and
# `_engine decide-all` below, which merges them with the parsed pane and returns one action.
#
# Sweep every LIVE registered session: tidy any stuck dialog, RE-ESTABLISH Remote Control when the
# state file says its bridge is genuinely ABSENT, and emit one deduped /login alert when the shared
# credential is logged out. Folded into `restore`, so one timer keeps sessions alive AND reachable.
_do_tidy_sweep() {
  local flag="$CLAUDE_KEEP_HOME/.login-alerted" login
  login="$(_login_state)"
  if [[ "$login" == login-needed ]]; then
    [[ -e "$flag" ]] || { notify "⚠ claude-keep: not logged in (no refresh token) — run: $CLAUDE auth login  (sessions run, but RC + API stay blocked)"; : > "$flag"; }
  else rm -f "$flag" 2>/dev/null || true; fi

  # RC-heal decisions come from the TESTED engine (lib/state_engine.py `decide`), computed ONCE
  # for the whole fleet (a single gather, not one per session). decide returns reissue-rc only for
  # an rc_desired, logged-in, idle session whose RC is genuinely down (bridge absent) — the one
  # signal that can't false-positive the way the `/rc` footer scrape did. Empty if python3 is
  # absent → we still tidy, just skip RC re-establishment (graceful degradation).
  local _decisions=""
  if command -v python3 >/dev/null; then
    local _lo=""; [[ "$login" == login-needed ]] && _lo="--logged-out"
    _decisions=$(_engine decide-all $_lo 2>/dev/null || true)
  fi

  local name pid uuid title action
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ -z "$_line" || "${_line:0:1}" == "#" ]] && continue
    _split_row "$_line"; name="$ROW_NAME"; uuid="$ROW_UUID"; title="${name#cc${EM}}"
    tmux has-session -t "=$name" 2>/dev/null || continue
    pid=$(_pane_of "$name"); [[ -z "$pid" ]] && continue

    _tidy_pane "$pid"     # first: answer a resume dialog / dismiss a stuck panel → clean prompt

    action=$(awk -F'\t' -v u="$uuid" '$1==u{print $2; exit}' <<<"$_decisions")
    if [[ "$action" == "reissue-rc" ]]; then
      tmux send-keys -t "$pid" "/remote-control ${title}"; sleep 0.4; tmux send-keys -t "$pid" Enter
      notify "ℹ claude-keep: re-issued /remote-control for '$name' (Remote Control bridge was absent)"
      sleep 1; _tidy_pane "$pid"   # confirm the one-time Enable-RC prompt if it appears
    fi
  done < "$TSV"
}

cmd_tidy() {
  ensure_registry
  command -v tmux >/dev/null || die "tmux not installed"
  _do_tidy_sweep
  _g "✓ tidied live sessions (stuck resume dialogs / RC panels cleared)"; echo
}

# ──────────────────────────────────────────────────────────────────
# doctor — audit the registry against the transcripts on disk. Flags every entry
# that can't be resumed as-registered: transcript DRIFTED to another cwd, the cwd
# is gone (DEAD-CWD), or the transcript is LOST. These are the sessions that die
# silently on `restore`. Read-only; suggests the fix per row.
cmd_doctor() {
  ensure_registry
  local total=0 ok=0 drift=0 lost=0 deadcwd=0
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ -z "$_line" || "${_line:0:1}" == "#" ]] && continue
    _split_row "$_line"
    local uuid="$ROW_UUID" cwd="$ROW_CWD" title="${ROW_NAME#cc${EM}}"
    total=$((total+1))
    local found
    if [[ -f "$(_projdir_for "$cwd")/$uuid.jsonl" ]]; then
      if [[ -d "$cwd" ]]; then ok=$((ok+1)); continue; fi
      deadcwd=$((deadcwd+1)); _y "  DEAD-CWD"; echo "  $title — cwd gone ($cwd) → migrate to a live cwd"
      continue
    fi
    found="$(_find_transcript "$uuid")"
    if [[ -n "$found" ]]; then
      drift=$((drift+1)); _y "  DRIFT   "; echo "  $title — transcript in $(basename "$(dirname "$found")") (registered cwd stale) → migrate"
    else
      lost=$((lost+1)); _r "  LOST    "; echo "  $title — no ${uuid:0:8}….jsonl anywhere → dead entry"
    fi
  done < "$TSV"
  echo
  echo "  $ok ok · $drift drift · $deadcwd dead-cwd · $lost lost   (of $total)"
  (( drift + deadcwd > 0 )) && echo "  → fix:    claude-keep migrate <session> <new-cwd>"
  (( lost > 0 ))            && echo "  → remove: claude-keep rm <session>   (lost entries are unresumable)"
  return 0   # a clean audit must not exit non-zero (the (( )) above would otherwise leak false)
}

# ──────────────────────────────────────────────────────────────────
# migrate <session> <new-cwd> — relocate a registered session's transcript to a new
# cwd (copy the jsonl into that cwd's project dir + repoint the registry) so it resumes
# there. For a DRIFT/DEAD-CWD entry from `doctor`, or to deliberately move a session's
# working directory. Copies (never moves) — the original jsonl stays as a backup.
cmd_migrate() {
  ensure_registry
  local q="${1:-}" newcwd="${2:-}"
  [[ -n "$q" && -n "$newcwd" ]] || die "usage: claude-keep migrate <session> <new-cwd>"
  local row name uuid
  row="$(awk -F'\t' -v q="$q" 'index($1,q)>0 {print; exit}' "$TSV")"
  [[ -n "$row" ]] || die "no registered session matching '$q'"
  name="$(cut -f1 <<<"$row")"; uuid="$(cut -f2 <<<"$row")"
  local src; src="$(_find_transcript "$uuid")"
  [[ -n "$src" ]] || die "no transcript ${uuid:0:8}… found anywhere — nothing to migrate (LOST entry)"
  local dstdir; dstdir="$(_projdir_for "$newcwd")"
  mkdir -p "$dstdir"
  cp "$src" "$dstdir/$uuid.jsonl"
  local tmp; tmp="$(mktemp)"
  awk -F'\t' -v OFS='\t' -v n="$name" -v c="$newcwd" '$1==n{$3=c} {print}' "$TSV" > "$tmp" && mv "$tmp" "$TSV"
  _g "✓ migrated: ${name#cc${EM}} → $newcwd"; echo
  echo "  transcript: $src"
  echo "           → $dstdir/$uuid.jsonl   (original kept as backup)"
  if tmux has-session -t "=$name" 2>/dev/null; then
    _y "  note: it's LIVE at the old cwd — kill that tmux + run 'claude-keep restore' to move it"; echo
  else
    echo "  not live → 'claude-keep restore' brings it up at the new cwd"
  fi
}

# ── state engine bridge (pure Python core; see lib/state_engine.py) ───────────
# Resolve lib/ relative to this script (repo root or plugin cache root — both put bin/ and lib/
# as siblings), so it works installed-as-plugin and from a clone alike.
_engine() { python3 "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/lib/state_engine.py" "$@"; }
cmd_status() { command -v python3 >/dev/null || die "python3 not installed (needed for the state engine)"; _engine status "$@"; }

usage() {
  sed -n '2,47p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ──────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    add)              cmd_add "$@" ;;
    rm|remove)        cmd_rm "$@" ;;
    ls|list)          cmd_ls "$@" ;;
    doctor|audit)     cmd_doctor "$@" ;;
    migrate)          cmd_migrate "$@" ;;
    restore)          cmd_restore "$@" ;;
    tidy)             cmd_tidy "$@" ;;
    status|state)     cmd_status "$@" ;;
    install-timer)    cmd_install_timer "$@" ;;
    uninstall-timer)  cmd_uninstall_timer "$@" ;;
    ""|help|-h|--help) usage ;;
    *) die "unknown command '$cmd' (try: claude-keep help)" ;;
  esac
}
main "$@"
